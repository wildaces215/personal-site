---
const socials = [
  { label: "LinkedIn", href: "https://linkedin.com/in/yourprofile", icon: "in" },
  { label: "GitHub", href: "https://github.com/yourusername", icon: "gh" },
  { label: "Email", href: "mailto:your@email.com", icon: "@" },
]
---

<section id="contact" class="mx-auto max-w-3xl px-6 py-24">
  <div class="mb-12">
    <span class="font-mono text-sm text-accent">// contact</span>
    <h2 class="mt-2 text-3xl font-bold text-zinc-100">Let's build something reliable</h2>
  </div>

  <p class="mb-8 text-zinc-400 leading-relaxed">
    I'm actively looking for opportunities in <span class="text-zinc-200">QA engineering</span>,
    <span class="text-zinc-200">AI/ML testing</span>, or <span class="text-zinc-200">MLOps</span>.
    If your team needs someone who thinks about quality at every layer — from test coverage
    to model evaluation — let's talk.
  </p>

  <div class="grid gap-4 sm:grid-cols-3">
    {socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 rounded-xl border border-zinc-800 bg-zinc-950/50 p-4 transition-all hover:border-accent hover:bg-zinc-900/50"
      >
        <span class="font-mono text-lg font-bold text-zinc-500 group-hover:text-accent transition-colors">
          {social.icon}
        </span>
        <span class="text-sm font-medium text-zinc-300 group-hover:text-zinc-100 transition-colors">
          {social.label}
        </span>
        <svg class="ml-auto h-4 w-4 text-zinc-600 group-hover:text-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>
    ))}
  </div>
</section>

<footer class="border-t border-zinc-800/50">
  <div class="mx-auto max-w-3xl px-6 py-8 text-center">
    <p class="font-mono text-xs text-zinc-600">
      Built with Astro + Tailwind · {new Date().getFullYear()}
    </p>
  </div>
</footer>