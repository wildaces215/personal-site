---
import GridBackground from './react/GridBackground.tsx'
import AnimatedBadge from './react/AnimatedBadge.tsx'
import TextGenerate from './react/TextGenerate.tsx'
import ShimmerButton from './react/ShimmerButton.tsx'
---

<section class="relative flex min-h-screen items-center justify-center overflow-hidden">
  <GridBackground client:load />

  <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
    <!-- Badge -->
    <div class="mb-8 flex justify-center">
      <AnimatedBadge client:load />
    </div>

    <!-- Name -->
    <h1 class="text-5xl font-bold leading-tight text-zinc-100 sm:text-7xl">
      Craig <span class="text-gradient-animated">Albertson</span>
    </h1>

    <!-- Role -->
    <p class="mt-3 font-mono text-sm text-accent sm:text-base">
      <TextGenerate client:load text="QA Analyst × AI Engineer" />
    </p>

    <!-- Tagline -->
    <p class="mx-auto mt-6 max-w-xl text-base text-zinc-400 sm:text-lg">
      4 years ensuring software quality. Now mastering AI/ML through Udacity's
      <span class="text-zinc-200"> Master of Science in AI</span>.
      I build the bridge between
      <span class="text-zinc-200"> reliable systems</span> and
      <span class="text-zinc-200"> intelligent automation</span>.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <ShimmerButton client:load href="#contact">Get in touch</ShimmerButton>
      <ShimmerButton client:load href="#experience" variant="secondary">View experience</ShimmerButton>
    </div>

    <!-- Quick stats -->
    <div class="mt-16 grid grid-cols-3 gap-4 text-center sm:gap-8">
      <div>
        <div class="font-mono text-2xl font-bold text-zinc-100 sm:text-3xl">4+</div>
        <div class="mt-1 text-xs text-zinc-500 sm:text-sm">Years in QA</div>
      </div>
      <div class="border-x border-zinc-800">
        <div class="font-mono text-2xl font-bold text-zinc-100 sm:text-3xl">MSc</div>
        <div class="mt-1 text-xs text-zinc-500 sm:text-sm">AI in progress</div>
      </div>
      <div>
        <div class="font-mono text-2xl font-bold text-zinc-100 sm:text-3xl">∞</div>
        <div class="mt-1 text-xs text-zinc-500 sm:text-sm">Bugs squashed</div>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <a href="#about" class="absolute bottom-8 left-1/2 -translate-x-1/2">
    <svg class="h-5 w-5 animate-bounce text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</section>