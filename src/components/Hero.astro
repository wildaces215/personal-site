---
---

<section class="relative flex min-h-screen items-center justify-center overflow-hidden">
  <!-- Grid background -->
  <div class="absolute inset-0 bg-grid"></div>
  <!-- Glow -->
  <div class="absolute inset-0 glow"></div>

  <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
    <!-- Status badge -->
    <div class="animate-fade-in mb-8 inline-flex items-center gap-2 rounded-full border border-zinc-700 bg-zinc-900/50 px-4 py-1.5">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      <span class="text-xs font-medium text-zinc-400">Open to opportunities</span>
    </div>

    <h1 class="animate-fade-in-up delay-100 text-4xl font-bold leading-tight text-zinc-100 sm:text-6xl">
      Craig Albertson
    </h1>

    <p class="animate-fade-in-up delay-100 mt-2 text-sm font-mono text-accent">
      QA Analyst × AI Engineer
    </p>

    <p class="animate-fade-in-up delay-200 mx-auto mt-6 max-w-xl text-lg text-zinc-400">
4 years ensuring software quality. Now mastering AI/ML through Udacity's Master of Science in AI.
      I build the bridge between <span class="text-zinc-200">reliable systems</span> and
      <span class="text-zinc-200">intelligent automation</span>.
    </p>

    <div class="animate-fade-in-up delay-300 mt-10 flex justify-center gap-4">
      <a
        href="#contact"
        class="rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-indigo-500 hover:shadow-lg hover:shadow-indigo-500/25"
      >
        Get in touch
      </a>
      <a
        href="#experience"
        class="rounded-lg border border-zinc-700 px-6 py-3 text-sm font-semibold text-zinc-300 transition-all hover:border-zinc-500 hover:text-zinc-100"
      >
        View experience
      </a>
    </div>

    <!-- Quick stats -->
    <div class="animate-fade-in-up delay-400 mt-16 grid grid-cols-3 gap-8 text-center">
      <div>
        <div class="font-mono text-2xl font-bold text-zinc-100">4+</div>
        <div class="mt-1 text-xs text-zinc-500">Years in QA</div>
      </div>
      <div>
        <div class="font-mono text-2xl font-bold text-zinc-100">MSc</div>
        <div class="mt-1 text-xs text-zinc-500">AI in progress</div>
      </div>
      <div>
        <div class="font-mono text-2xl font-bold text-zinc-100">∞</div>
        <div class="mt-1 text-xs text-zinc-500">Bugs squashed</div>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <a href="#about" class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-fade-in delay-500">
    <svg class="h-5 w-5 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</section>