---
const education = [
  {
    degree: "M.Sc. Artificial Intelligence — Udacity Institute of AI & Technology",
    status: "In Progress",
    description: "Accredited master's degree program built on project-based, industry-aligned coursework. Curriculum covers machine learning, deep learning, NLP, and AI systems engineering. Hands-on projects include building a Transformer model from scratch with PyTorch and neural network implementation.",
  },
  {
    degree: "B.Sc. [Your Field]",
    status: "Completed",
    description: "Foundational degree that launched the journey into tech and quality assurance.",
  }
]
---

<section id="education" class="border-y border-zinc-800/50 bg-zinc-900/30">
  <div class="mx-auto max-w-3xl px-6 py-24">
    <div class="mb-12">
      <span class="font-mono text-sm text-accent">// education</span>
      <h2 class="mt-2 text-3xl font-bold text-zinc-100">Learning never stops</h2>
    </div>

    <div class="space-y-6">
      {education.map((edu) => (
        <div class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-6">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-semibold text-zinc-100">{edu.degree}</h3>
            <span class={`rounded-full px-3 py-1 text-xs font-medium ${edu.status === "In Progress" ? "bg-indigo-500/10 text-indigo-400 border border-indigo-500/20" : "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"}`}>
              {edu.status}
            </span>
          </div>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{edu.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>