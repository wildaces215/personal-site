---
import Reveal from './react/Reveal.tsx'

const education = [
  {
    degree: "M.Sc. Artificial Intelligence — Udacity Institute of AI & Technology",
    status: "In Progress",
    description: "Accredited master's degree program built on project-based, industry-aligned coursework. Curriculum covers machine learning, deep learning, NLP, and AI systems engineering. Hands-on projects include building a Transformer model from scratch with PyTorch and neural network implementation.",
  },
  {
    degree: "B.A. Computer and Information Sciences, Minor in Web Development — Charleston Southern University, North Charleston, SC",
    status: "Completed",
    description: "Foundational degree that launched the journey into tech and quality assurance. Coursework covered programming, database systems, and web development, building a strong base for a career in software quality and AI.",
  }
]
---

<section id="education" class="border-y border-zinc-800/50 bg-zinc-900/30">
  <div class="mx-auto max-w-3xl px-6 py-20 sm:py-24">
    <Reveal client:load>
      <div class="mb-12">
        <span class="font-mono text-sm text-accent">// education</span>
        <h2 class="mt-2 text-2xl font-bold text-zinc-100 sm:text-3xl">Learning never stops</h2>
      </div>
    </Reveal>

    <div class="space-y-6">
      {education.map((edu, i) => (
        <Reveal client:load delay={i * 0.15}>
          <div class="group rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6 transition-all hover:border-zinc-700">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-base font-semibold text-zinc-100 sm:text-lg">{edu.degree}</h3>
              <span class={`mt-2 inline-block w-fit rounded-full px-3 py-1 text-xs font-medium sm:mt-0 ${edu.status === "In Progress" ? "bg-indigo-500/10 text-indigo-400 border border-indigo-500/20" : "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"}`}>
                {edu.status}
              </span>
            </div>
            <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{edu.description}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>