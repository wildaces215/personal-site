---
import Reveal from './react/Reveal.tsx'

const experiences = [
  {
    role: "QA Analyst — Proctor Loan Protector",
    period: "Recent",
    description: "Owned quality assurance for Proctor Loan Protector's lending and insurance platforms. Executed functional, regression, and API testing, and worked closely with development teams to catch defects early in the SDLC.",
    highlights: [
      "Conducted comprehensive functional testing across lending platform products",
      "Executed regression, API, and integration testing to ensure release quality",
      "Collaborated with dev teams to integrate quality checks into CI/CD pipelines",
    ]
  },
  {
    role: "QA Analyst — Infosys Limited",
    period: "Earlier",
    description: "Delivered quality assurance services for enterprise clients at Infosys, one of the world's largest IT consulting firms. Worked across multiple project domains, executing functional testing strategies for large-scale systems.",
    highlights: [
      "Performed functional, regression, and user acceptance testing for enterprise clients",
      "Collaborated within large distributed teams across the full SDLC",
      "Developed test plans, test cases, and defect reports with rigorous documentation",
    ]
  }
]
---

<section id="experience" class="mx-auto max-w-3xl px-6 py-20 sm:py-24">
  <Reveal client:load>
    <div class="mb-12">
      <span class="font-mono text-sm text-accent">// experience</span>
      <h2 class="mt-2 text-2xl font-bold text-zinc-100 sm:text-3xl">Where I've been</h2>
    </div>
  </Reveal>

  <div class="relative border-l border-zinc-800 pl-8">
    {experiences.map((exp, i) => (
      <Reveal client:load delay={i * 0.15}>
        <div class="relative mb-12 last:mb-0">
          <!-- Dot -->
          <div class="absolute -left-[33px] top-1.5 h-3 w-3 rounded-full border-2 border-accent bg-zinc-950"></div>

          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-base font-semibold text-zinc-100 sm:text-lg">{exp.role}</h3>
            <span class="font-mono text-sm text-zinc-500">{exp.period}</span>
          </div>

          <p class="mt-3 text-sm text-zinc-400 leading-relaxed sm:text-base">{exp.description}</p>

          <ul class="mt-4 space-y-2">
            {exp.highlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-zinc-500">
                <span class="mt-1 text-accent">▹</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      </Reveal>
    ))}

    <!-- Future entry -->
    <Reveal client:load delay={0.3}>
      <div class="relative opacity-40">
        <div class="absolute -left-[33px] top-1.5 h-3 w-3 rounded-full border-2 border-zinc-700 bg-zinc-950"></div>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="text-base font-semibold text-zinc-300 sm:text-lg">Next chapter...</h3>
          <span class="font-mono text-sm text-zinc-600">2025 —</span>
        </div>
        <p class="mt-3 text-sm text-zinc-600 italic">Looking for roles in AI/ML testing, MLOps, or QA engineering. Let's talk.</p>
      </div>
    </Reveal>
  </div>
</section>